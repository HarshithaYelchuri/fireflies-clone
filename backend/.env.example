# SQLAlchemy database URL. Defaults to a SQLite file inside backend/.
DATABASE_URL=sqlite:///./fireflies.db
# Comma-separated list of origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000
# Seed demo meetings and the demo account automatically on startup (true/false).
AUTO_SEED=true
# Google sign-in: an OAuth 2.0 "Web application" client ID from Google Cloud Console.
# Leave empty to disable Google sign-in (email/password and the demo account still work).
GOOGLE_CLIENT_ID=
# How long a sign-in session lasts, in days.
SESSION_DAYS=30
